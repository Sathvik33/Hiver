DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiver_support

# AI / Model Provider settings: ollama | groq | openrouter
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Embedding & Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.60
INTENT_CONFIDENCE_THRESHOLD=0.65

# Brand Configuration
SELECTED_BRAND=AmazonHelp
